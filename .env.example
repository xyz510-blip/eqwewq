# OpenSearch — Yuhan's LAB Environment Configuration
# Copy this file to .env and fill in any API keys you have.
# All core tools (Maigret, Sherlock, Shodan InternetDB, RDAP, DNS/SSL, Phone/Email/URL heuristics)
# work WITHOUT API keys! Adding keys unlocks deeper threat intelligence.

# Shodan Full Host & Banner API (optional — InternetDB works free without key)
SHODAN_API_KEY=

# VirusTotal v3 API (optional — URL & Domain malware reputation)
VIRUSTOTAL_API_KEY=

# AbuseIPDB v2 API (optional — IP abuse & spammer reports)
ABUSEIPDB_API_KEY=

# Have I Been Pwned API (optional — Email data breach history)
HIBP_API_KEY=

# Hunter.io API (optional — Email deliverability & corporate profile lookup)
HUNTER_API_KEY=

# IPinfo.io Token (optional — Extended ASN/geolocation intelligence)
IPINFO_TOKEN=

# urlscan.io API Key (optional — Public search works without key; key enables private scans)
URLSCAN_API_KEY=

# Numverify API Key (optional — International carrier & line-type verification)
NUMVERIFY_API_KEY=

# Etherscan API Key (optional — Blockscout fallback works free without key)
ETHERSCAN_API_KEY=

# Flask Web Dashboard Secret Key
OPENSEARCH_SECRET_KEY=change-this-to-a-random-local-secret
